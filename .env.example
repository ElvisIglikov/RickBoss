# Скопируй в .env (он в .gitignore) и впиши свои значения. Пусто — функция выключена.

# Файлы хозяину в Telegram через его бота (tools/bot_send.py).
# Токен — у @BotFather (/newbot). CHAT_ID — твой личный чат с ботом: напиши боту /start,
# открой https://api.telegram.org/bot<токен>/getUpdates и возьми message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
